# Copy this file to firmware/secrets.yaml and fill in your real values.
# secrets.yaml is gitignored and must NEVER be committed.

# --- WiFi ---
wifi_ssid: "your-ssid-here"
wifi_password: "your-wifi-password"

# --- ESPHome API ---
# Generate a 32-byte base64 key with:
#   openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32B_KEY"

# --- OTA ---
# Any string; just remember it for esphome upload
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# --- AP fallback (only used if WiFi fails to connect) ---
fallback_ap_password: "REPLACE_WITH_AP_PASSWORD"

# --- Panel static IP for OTA ---
# Set a DHCP reservation in your router so this IP always points to the panel,
# then put it here so esphome run --device <ip> works without changes.
panel_static_ip: "192.168.1.100"

# --- BlueSun BMS master pack MAC address ---
# Find it with the Octopus BMS Android app (the pack you can connect to is
# the master) or with nRF Connect (look for a device named like BNxxxxxxxxxx).
# Format: aa:bb:cc:dd:ee:ff (uppercase, colon-separated)
bms_master_mac: "AA:BB:CC:DD:EE:FF"
